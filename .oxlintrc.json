{
  "plugins": ["typescript", "react", "vitest"],
  "ignorePatterns": ["legacy/**", "**/dist/**", "node_modules/**"],
  "rules": {
    "no-debugger": "error",
    "no-throw-literal": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "react/jsx-key": "error",
    "vitest/no-disabled-tests": "error"
  },
  "overrides": [
    {
      "files": ["alchemy.run.ts", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
