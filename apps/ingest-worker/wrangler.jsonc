{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "course-data-ingest",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-20",
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "course-data-evidence-local",
    },
  ],
  "vars": {
    "ON_DEMAND_INGEST": "true",
  },
  "observability": {
    "enabled": true,
  },
}
