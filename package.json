{
  "name": "course-data-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api-worker db:migrate:local && bun run --cwd apps/api-worker dev",
    "check": "bun run fmt:check && bun run lint && bun run check:types",
    "check:types": "bash scripts/typecheck.sh tsc",
    "check:types:ts6": "bash scripts/typecheck.sh tsc6",
    "check:types:compat": "bun run check:types && bun run check:types:ts6",
    "test": "vitest run",
    "build": "bash scripts/build.sh",
    "openapi": "bun apps/api-worker/scripts/export-openapi.ts",
    "deploy": "bash scripts/deploy.sh",
    "validate": "bash scripts/validate.sh",
    "legacy:dev": "bun run --cwd legacy/ntnu-course-search dev",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint --deny-warnings .",
    "dev:preview": "bun scripts/dev.ts --preview",
    "dev:stack": "bun scripts/dev.ts",
    "ui:info": "bunx shadcn@latest info -c apps/web",
    "ui:add": "bunx shadcn@latest add -c apps/web",
    "ui:diff": "bunx shadcn@latest diff -c apps/web",
    "theme:resolve": "bun scripts/theme-preset.ts resolve",
    "theme:decode": "bun scripts/theme-preset.ts decode",
    "theme:open": "bun scripts/theme-preset.ts open",
    "theme:apply": "bun scripts/theme-preset.ts apply"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "alchemy": "0.93.12",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@cloudflare/unenv-preset": "2.16.1",
    "esbuild": "0.28.1",
    "miniflare": "4.20260714.0",
    "unenv": "2.0.0-rc.24",
    "wrangler": "4.112.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
