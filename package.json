{
  "name": "course-data-platform",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --cwd apps/student-web dev",
    "dev:api": "bun run --cwd apps/course-api dev",
    "check": "bun run fmt:check && bun run lint && bun run i18n:check && bun run check:types",
    "i18n:check": "bun run --cwd apps/student-web i18n:check",
    "check:types": "bash scripts/typecheck.sh",
    "test": "bun scripts/test.ts",
    "test:a11y": "bun run --cwd apps/student-web test:a11y",
    "build": "bash scripts/build.sh",
    "openapi": "bun apps/course-api/scripts/export-openapi.ts",
    "infra:plan": "alchemy plan alchemy.run.ts",
    "infra:plan:prod": "alchemy plan --stage prod alchemy.run.ts",
    "infra:dev": "alchemy dev alchemy.run.ts",
    "deploy": "alchemy deploy alchemy.run.ts",
    "deploy:preview": "bun scripts/deploy-preview.ts",
    "deploy:prod": "bun scripts/deploy-prod.ts",
    "validate": "bash scripts/validate.sh",
    "legacy:dev": "bun run --cwd legacy/ntnu-course-search dev",
    "legacy:dev:platform": "bun scripts/dev-legacy.ts",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "hooks:install": "bun scripts/install-git-hooks.ts",
    "prepare": "bun run hooks:install",
    "dev:preview": "bun scripts/dev.ts --preview",
    "dev:stack": "bun scripts/dev.ts",
    "ui:info": "bunx shadcn@latest info -c apps/web",
    "ui:add": "bunx shadcn@latest add -c apps/web",
    "ui:diff": "bunx shadcn@latest diff -c apps/web",
    "theme:resolve": "bun scripts/theme-preset.ts resolve",
    "theme:decode": "bun scripts/theme-preset.ts decode",
    "theme:open": "bun scripts/theme-preset.ts open",
    "theme:apply": "bun scripts/theme-preset.ts apply"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@effect/platform-bun": "4.0.0-beta.97",
    "@effect/platform-node": "4.0.0-beta.97",
    "@foldkit/oxlint-plugin": "0.4.0",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "alchemy": "2.0.0-beta.63",
    "effect": "4.0.0-beta.97",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@cloudflare/unenv-preset": "2.16.1",
    "effect-oxlint": "0.3.2",
    "esbuild": "0.28.1",
    "miniflare": "4.20260714.0",
    "unenv": "2.0.0-rc.24",
    "wrangler": "4.112.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
