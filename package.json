{
  "name": "course-data-platform",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/course-api",
    "apps/student-web",
    "infra",
    "packages/course-contracts"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --cwd apps/student-web dev",
    "dev:api": "bun run --cwd apps/course-api dev",
    "check": "bun run fmt:check && bun run lint && bun run i18n:check && bun run check:types",
    "i18n:check": "bun run --cwd apps/student-web i18n:check",
    "check:types": "bash scripts/typecheck.sh",
    "test": "bun scripts/test.ts",
    "test:web": "bun scripts/test.ts apps/student-web",
    "test:journeys": "bun run --cwd apps/student-web test:journeys",
    "build": "bash scripts/build.sh",
    "openapi": "bun apps/course-api/scripts/export-openapi.ts",
    "infra:plan": "infra/node_modules/.bin/alchemy plan infra/alchemy.run.ts",
    "infra:plan:prod": "infra/node_modules/.bin/alchemy plan --stage prod infra/alchemy.run.ts",
    "infra:dev": "infra/node_modules/.bin/alchemy dev infra/alchemy.run.ts",
    "deploy": "infra/node_modules/.bin/alchemy deploy infra/alchemy.run.ts",
    "deploy:preview": "bun scripts/deploy-preview.ts",
    "deploy:prod": "bun scripts/deploy-prod.ts",
    "validate": "bash scripts/validate.sh",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "hooks:install": "bun scripts/install-git-hooks.ts",
    "prepare": "bun run hooks:install",
    "dev:preview": "bun scripts/dev.ts --preview",
    "dev:stack": "bun scripts/dev.ts"
  },
  "devDependencies": {
    "@foldkit/oxlint-plugin": "0.15.0",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "effect": "4.0.0-rc.116",
    "fast-check": "4.10.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@cloudflare/unenv-preset": "2.16.2",
    "effect-oxlint": "0.3.4",
    "esbuild": "0.28.1",
    "miniflare": "5.20260921.0-alpha",
    "unenv": "2.0.0-rc.24",
    "wrangler": "4.136.1"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
